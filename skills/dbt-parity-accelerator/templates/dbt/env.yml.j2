env_config:
  default_environment: [[ environments[0].env_yml_env ]]
  environments:
[%- for e in environments %]
    - name: [[ e.env_yml_env ]]
      env:
        DBT_SCHEMA: [% if e.per_user_schema %]"{{ select 'DBT_' || CURRENT_USER() }}"[% else %][[ dbt.object_schema ]][% endif %]
[%- for k, v in (dbt.extra_env_vars | dictsort) %]
        [[ k ]]: [[ v.get(e.name, v.get('default', '')) | tojson ]]
[%- endfor %]
[%- endfor %]
[%- if ci.enabled %]
    # CI pipelines override DBT_SCHEMA with [[ ci.pr_schema_prefix ]]<n>.
    - name: [[ ci.env_yml_env ]]
      env:
        DBT_SCHEMA: [[ ci.schema ]]
[%- for k, v in (dbt.extra_env_vars | dictsort) %]
        [[ k ]]: [[ v.get('ci', v.get('default', '')) | tojson ]]
[%- endfor %]
[%- endif %]
